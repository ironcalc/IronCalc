{
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "correctness": { "noUnusedImports": "error" },
      "style": { "useBlockStatements": "error" }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["src/locale/*.json"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "on"
          }
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": { "noSvgWithoutTitle": "off" }
        }
      }
    }
  ]
}
