{
  "name": "embed.ironcalc.com",
  "private": true,
  "version": "0.8.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "dist": "npm run build && npm run build:embed",
    "preview": "vite preview",
    "check": "biome check ./src *.html *.json",
    "typecheck": "tsc -b",
    "check-write": "biome check --write ./src *.html *.json"
  },
  "dependencies": {
    "@ironcalc/workbook": "file:../IronCalc/",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  }
}
