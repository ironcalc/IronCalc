    def set_show_grid_lines(self, sheet: int, show_grid_lines: bool) -> None: ...

    # Links
    def get_cell_link(self, sheet: int, row: int, column: int) -> LinkDict | None: ...
    def set_cell_link(
        self, sheet: int, row: int, column: int, link: LinkDict
    ) -> None: ...
    def delete_cell_link(self, sheet: int, row: int, column: int) -> None: ...
    def get_links(self, sheet: int) -> list[CellLinkDict]: ...

    # Defined names
    def get_defined_name_list(self) -> list[DefinedNameDict]: ...
    def new_defined_name(
        self, name: str, scope: int | None, formula: str
    ) -> None: ...
    def update_defined_name(
        self,
        name: str,
        scope: int | None,
        new_name: str,
        new_scope: int | None,
        new_formula: str,
    ) -> None: ...
    def delete_defined_name(self, name: str, scope: int | None) -> None: ...

    # Workbook properties
    def get_theme(self) -> dict[str, Any]: ...
    def set_theme(self, theme: dict[str, Any]) -> None: ...
    def get_timezone(self) -> str: ...
    def set_timezone(self, timezone: str) -> None: ...
    def get_locale(self) -> str: ...
    def set_locale(self, locale: str) -> None: ...
    def get_language(self) -> str: ...
    def set_language(self, language: str) -> None: ...
    def get_fmt_settings(self) -> dict[str, str]: ...
    def test_panic(self) -> None: ...

class UserModel:
    """A workbook with the user, high level API: the same API used by the
    IronCalc web application.

    Every action evaluates the workbook, keeps undo/redo history and produces
    diffs for collaboration.
    """

    def __init__(
        self,
        name: str,
        locale: str = "en",
        tz: str = "UTC",
        language_id: str = "en",
    ) -> None: ...
    @staticmethod
    def from_bytes(bytes: bytes, language_id: str = "en") -> UserModel: ...
    @staticmethod
    def from_xlsx(
        file_path: str, locale: str = "en", tz: str = "UTC", language_id: str = "en"
    ) -> UserModel: ...
    @staticmethod
    def from_icalc(file_name: str, language_id: str = "en") -> UserModel: ...

    # Persistence
    def save_to_xlsx(self, file: str) -> None: ...
    def save_to_icalc(self, file: str) -> None: ...
    def to_bytes(self) -> bytes: ...

    # Collaboration
    def apply_external_diffs(self, external_diffs: bytes) -> None: ...
    def flush_send_queue(self) -> bytes: ...

    # Undo / redo and evaluation
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def can_undo(self) -> bool: ...
    def can_redo(self) -> bool: ...
    def pause_evaluation(self) -> None: ...
    def resume_evaluation(self) -> None: ...
    def evaluate(self) -> None: ...

    # Workbook properties
    def get_name(self) -> str: ...
    def set_name(self, name: str) -> None: ...
    def get_timezone(self) -> str: ...
    def set_timezone(self, timezone: str) -> None: ...
    def get_locale(self) -> str: ...
    def set_locale(self, locale: str) -> None: ...
    def get_language(self) -> str: ...
    def set_language(self, language: str) -> None: ...
    def get_fmt_settings(self) -> dict[str, str]: ...
    def get_theme(self) -> dict[str, Any]: ...
    def set_theme(self, theme: dict[str, Any]) -> None: ...
    def resolve_color(self, color: Color) -> str: ...

    # Cell values
    def set_user_input(self, sheet: int, row: int, column: int, value: str) -> None: ...
    def set_user_array_formula(
        self, sheet: int, row: int, column: int, width: int, height: int, formula: str
    ) -> None: ...
    def get_cell_content(self, sheet: int, row: int, column: int) -> str: ...
    def get_formatted_cell_value(self, sheet: int, row: int, column: int) -> str: ...
    def get_cell_type(self, sheet: int, row: int, column: int) -> CellType: ...
    def get_cell_array_structure(
        self, sheet: int, row: int, column: int
    ) -> dict[str, Any] | str: ...
    def get_sheet_dimensions(self, sheet: int) -> tuple[int, int, int, int]: ...

    # Ranges
    def range_clear_all(
        self, sheet: int, start_row: int, start_column: int, end_row: int, end_column: int
    ) -> None: ...
    def range_clear_contents(
        self, sheet: int, start_row: int, start_column: int, end_row: int, end_column: int
    ) -> None: ...
    def range_clear_formatting(
        self, sheet: int, start_row: int, start_column: int, end_row: int, end_column: int
    ) -> None: ...
    def auto_fill_rows(
        self,
        sheet: int,
        start_row: int,
        start_column: int,
        end_row: int,
        end_column: int,
        to_row: int,
    ) -> None: ...
    def auto_fill_columns(
        self,
